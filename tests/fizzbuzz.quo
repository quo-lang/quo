var dbg = import("debug")

var fizz_count = 0
var buzz_count = 0
var fizzbuzz_count = 0

var i = 0
while (i <= 100) {
    if i % 15 == 0 {
        fizzbuzz_count += 1
    } else if i % 3 == 0 {
        fizz_count += 1
    } else if i % 5 == 0 {
        buzz_count += 1
    }
    i += 1
}

dbg.assert(fizz_count == 27)
dbg.assert(buzz_count == 14)
dbg.assert(fizzbuzz_count == 7)
