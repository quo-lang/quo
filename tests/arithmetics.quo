var assert = fn(condition) if !condition exit(1)

# Basic arithmetic
assert(69 + 1 == 70)
assert(69 - 2 == 67)
assert(10 / 5 == 2)
assert(10 * -10 == -100)

# Multiplication and division precedence
assert(2 + 3 * 4 == 14)
assert(2 * 3 + 4 == 10)
assert(10 - 6 / 2 == 7)
assert(6 / 2 - 10 == -7)

# Parentheses grouping
assert((2 + 3) * 4 == 20)
assert(2 * (3 + 4) == 14)
assert((10 - 6) / 2 == 2)
assert(10 - (6 / 2) == 7)

# Complex expressions
assert(1 + 2 * 3 - 4 / 2 == 5)
assert((1 + 2) * (3 - 4) / 2 == -1.5)
assert(10 / 2 * 5 == 25)
assert(10 * 2 / 5 == 4)
assert(((69 - 10) + 1) / 5 * 2 == 24)
assert((((1 + 2) * 3) - 4) / 5 == 1)
assert(1 + (2 * (3 - (4 / 5))) == 5.4)
assert((((10 / 2) * (3 + 1)) - 5) * 2 == 30)

# Negation
assert(-5 == -5)
assert(-5 + 10 == 5)
assert(10 + -5 == 5)
assert(-(3 + 2) == -5)

# Large numbers
assert(1000 * 1000 == 1000000)
assert(1000000 / 1000 == 1000)
assert(999999 + 1 == 1000000)

# Zero and edge cases
assert(0 == 0)
assert(0 + 0 == 0)
assert(0 * 100 == 0)
assert(100 * 0 == 0)
assert(0 / 5 == 0)
assert(-0 == 0)
