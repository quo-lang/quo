var dbg = import("debug")

# Basic arithmetic
dbg.assert(69 + 1 == 70)
dbg.assert(69 - 2 == 67)
dbg.assert(10 / 5 == 2)
dbg.assert(10 * -10 == -100)

# Multiplication and division precedence
dbg.assert(2 + 3 * 4 == 14)
dbg.assert(2 * 3 + 4 == 10)
dbg.assert(10 - 6 / 2 == 7)
dbg.assert(6 / 2 - 10 == -7)

# Parentheses grouping
dbg.assert((2 + 3) * 4 == 20)
dbg.assert(2 * (3 + 4) == 14)
dbg.assert((10 - 6) / 2 == 2)
dbg.assert(10 - (6 / 2) == 7)

# Complex expressions
dbg.assert(1 + 2 * 3 - 4 / 2 == 5)
dbg.assert((1 + 2) * (3 - 4) / 2 == -1.5)
dbg.assert(10 / 2 * 5 == 25)
dbg.assert(10 * 2 / 5 == 4)
dbg.assert(((69 - 10) + 1) / 5 * 2 == 24)
dbg.assert((((1 + 2) * 3) - 4) / 5 == 1)
dbg.assert(1 + (2 * (3 - (4 / 5))) == 5.4)
dbg.assert((((10 / 2) * (3 + 1)) - 5) * 2 == 30)

# Negation
dbg.assert(-5 == -5)
dbg.assert(-5 + 10 == 5)
dbg.assert(10 + -5 == 5)
dbg.assert(-(3 + 2) == -5)

# Large numbers
dbg.assert(1000 * 1000 == 1000000)
dbg.assert(1000000 / 1000 == 1000)
dbg.assert(999999 + 1 == 1000000)

# Zero and edge cases
dbg.assert(0 == 0)
dbg.assert(0 + 0 == 0)
dbg.assert(0 * 100 == 0)
dbg.assert(100 * 0 == 0)
dbg.assert(0 / 5 == 0)
dbg.assert(-0 == 0)
