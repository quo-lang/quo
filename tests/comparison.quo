var dbg = import("debug")

# Integers
dbg.assert(5 > 3 == true)
dbg.assert(3 > 5 == false)
dbg.assert(5 >= 5 == true)
dbg.assert(4 >= 5 == false)
dbg.assert(3 < 5 == true)
dbg.assert(5 < 3 == false)
dbg.assert(5 <= 5 == true)
dbg.assert(5 <= 4 == false)

dbg.assert(5 == 5 == true)
dbg.assert(5 == 3 == false)
dbg.assert(5 != 3 == true)
dbg.assert(5 != 5 == false)
